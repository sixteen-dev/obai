# OpenAI API Key (required)
OPENAI_API_KEY=sk-proj-your-key-here

# Model Configuration (optional - defaults shown)
#
# The hub's model and reasoning effort normally live in ~/.obai/settings.json,
# written by the web UI settings modal and by `obai config set-model` /
# `obai config set-effort`. Uncommenting either line below pins the hub and
# WINS over that file, so the UI and CLI will appear to do nothing. Changes
# apply on the next hub start (`obai restart`), never mid-session.
#
# ORCHESTRATOR_MODEL=gpt-5.6-sol             # gpt-5.6-sol | gpt-5.6-terra
# ORCHESTRATOR_REASONING_EFFORT=medium       # none|low|medium|high|xhigh|max
SPECIALIST_MODEL=gpt-5.6-luna

# Guardrails (optional - defaults to true)
# Enable input guardrails to filter non-financial queries
ENABLE_GUARDRAILS=true

# MCP Server URLs (required)
# These should point to your running MCP servers
MCP_FUNDAMENTALS_URL=http://localhost:8001/mcp
MCP_MARKET_DATA_URL=http://localhost:8002/mcp
MCP_EVENTS_NEWS_URL=http://localhost:8003/mcp
MCP_OPTIONS_URL=http://localhost:8004/mcp
MCP_SCREENER_URL=http://localhost:8005/mcp

# MCP Client Configuration (optional)
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3
