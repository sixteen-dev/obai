# Environment Configuration for tezQ MCP Server
# Copy this file to .env and fill in your actual values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# AWS Configuration
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Alpaca Market Data API
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# OpenAI API for Embeddings
OPENAI_API_KEY=your_openai_api_key_here

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=stockmcp-dev
NEWS_HOT_TABLE=news_hot
REDDIT_POSTS_TABLE=reddit_posts

# S3 Vector Storage
S3_VECTOR_BUCKET=stock-mcp-vector-cache-us-east-2
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
FAISS_INDEX_REFRESH_INTERVAL=300

# Performance Configuration
MAX_CONCURRENT_REQUESTS=50
CACHE_TTL_DEFAULT=300
VECTOR_SIMILARITY_THRESHOLD=0.85

# Development Settings (set to true for local development)
USE_LOCALSTACK=false
LOCALSTACK_ENDPOINT=http://localhost:4566
